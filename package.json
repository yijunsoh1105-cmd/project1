{
  "name": "eco-electricity-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"import('http').then(({default:h})=>import('fs').then(({default:f})=>h.createServer((_,r)=>{r.writeHead(200,{'Content-Type':'text/html; charset=utf-8'});f.createReadStream('index.html').pipe(r)}).listen(3000,'0.0.0.0',()=>console.log('Static server running at http://0.0.0.0:3000'))))\" --",
    "build": "node -e \"import('fs').then(({default:f})=>{f.mkdirSync('dist',{recursive:true});f.copyFileSync('index.html','dist/index.html');console.log('Built dist/index.html')})\"",
    "preview": "node -e \"import('http').then(({default:h})=>import('fs').then(({default:f})=>h.createServer((_,r)=>{r.writeHead(200,{'Content-Type':'text/html; charset=utf-8'});f.createReadStream('dist/index.html').pipe(r)}).listen(3000,'0.0.0.0')))\" --",
    "lint": "node -e \"import('fs').then(({default:f})=>import('vm').then(({default:v})=>{const h=f.readFileSync('index.html','utf8');const m=h.match(/<script>([\\s\\S]*)<\\/script>/);if(!m)throw new Error('Missing inline script');new v.Script(m[1]);console.log('index.html script syntax OK')}))\""
  }
}
